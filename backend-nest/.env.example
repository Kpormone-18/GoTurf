# Application
NODE_ENV=development
PORT=8001
APP_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://username:password@localhost:5432/goturf
REDIS_URL=redis://localhost:6379

# Required before production. Use a secret manager, never source control.
JWT_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
EMAIL_FROM=GoTurf <bookings@example.com>

# SMS: Hubtel Ghana. Confirm sender-ID approval and current endpoint in the Hubtel portal.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=GoTurf
HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send

# Keep the FastAPI app only during the verified API-parity transition.
LEGACY_API_URL=http://127.0.0.1:8000
