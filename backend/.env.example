# Required application services
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/goturf
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Development only. Keep false in staging/production; do not commit demo passwords.
SEED_DEMO_DATA=false
SEED_DEMO_OWNER_PASSWORD=
SEED_DEMO_CUSTOMER_PASSWORD=

# Frontend origin(s), comma separated. Never use * in production.
CORS_ORIGINS=http://localhost:3000

# Payments: Paystack (leave blank for local mock checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email: Resend (optional; disabled until both values are set)
RESEND_API_KEY=
EMAIL_FROM=GoTurf <bookings@your-verified-domain.com>

# SMS: Hubtel Ghana (optional; disabled until all values are set)
# Confirm sender-ID approval and current API endpoint in the Hubtel developer portal.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=GoTurf
HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send

# Owner-verification documents: any S3-compatible bucket (optional)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2, MinIO, etc.; leave blank for AWS S3.
S3_ENDPOINT_URL=

# Protect cron endpoints with a long random value.
WEBHOOK_CRON_SECRET=
